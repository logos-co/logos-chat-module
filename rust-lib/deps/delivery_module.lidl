; delivery_module contract — the subset chat_module uses. Supplied as a
; dependency_override (see metadata.json). logos-lidl-gen turns this file into
; the typed `DeliveryModuleClient` that actions.rs/delivery.rs/inbound.rs call
; (createNode/start/subscribe/send + the messageReceived/connectionStateChanged
; decoders). Hand-maintained, so keep it in sync with the pinned rev: a stale
; event signature does not fail the build, it fails to decode at runtime.
module delivery_module {
  version "0.3.0"

  method createNode(config: tstr) -> result
  method start() -> result
  method subscribe(contentTopic: tstr) -> result
  method send(contentTopic: tstr, payload: bstr) -> result
  method getNodeInfo(nodeInfoId: tstr) -> result

  event messageReceived(messageHash: tstr, contentTopic: tstr, payload: bstr, source: tstr, timestamp: int)
  event connectionStateChanged(status: tstr, timestamp: int)
}
